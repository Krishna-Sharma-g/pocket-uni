ENVIRONMENT=production
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=pocketuni
DB_USER=your_database_user
DB_PASSWORD=replace_with_database_password
SECRET_KEY=generate_a_unique_random_secret

LOCAL_DEV_AUTH_ENABLED=false
GEMINI_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_from_aistudio_google_com
GROQ_API_KEY=your_free_groq_api_key_from_console_groq_com

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-frontend-host/

CORS_ORIGINS=["https://your-frontend-host"]
SUPER_ADMIN_ALLOWLIST=["your-admin-email@example.com"]
STUDENT_EMAIL_DOMAINS=["mitsgwl.ac.in"]
FACULTY_EMAIL_DOMAINS=["mitsgwalior.in"]